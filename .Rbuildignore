^\.Rapp\.history$

# Git
^\.git$
^\.gitignore$
^\.gitattributes$

# IDE / dev tools
^\.codebuddy$
^\.fresh$
^\.lintr$
^\.positai$
^\.claude$

# CI/CD
^\.github$
^codecov\.yml$

# Documentation build artifacts
^docs$
^pkgdown$
^pkgdown/.*
